# OpenShell sandbox image of the VM proof (harness/run-vm.sh, issue #45):
# the pinned opencode base image of the OpenShell rig (same digest as
# harness/images/Dockerfile.opensbx) plus the tmb client taken from the tmb
# package installed in the VM. No key and no certificate is baked in: the
# sandbox makes its own key with `tmb keygen` (ADR 0005).
FROM ghcr.io/anomalyco/opencode@sha256:6ebc13097f2381301220abe9d1b2a54f50cd1603a910dc1c66e93d8f2c4e8ebb
# The gateway resolves the workload uid/gid from /etc/passwd and refuses root.
RUN adduser -D -u 1000 sandbox
COPY tmb /usr/local/bin/tmb
# hadolint ignore=DL3066 # named on purpose: the gateway resolves the workload from /etc/passwd
USER sandbox
WORKDIR /home/sandbox
CMD ["sleep", "infinity"]
