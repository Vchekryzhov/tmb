# PROTOTYPE - throwaway PoC. sandbox-sim container: unprivileged stand-in
# for the future OpenShell sandbox (OpenShell wiring is a later follow-up).
# NO sudo installed, NO docker.sock, --network none at runtime for the
# N-series (unix path); the mTLS pair harness (run-pair.sh) additionally
# puts this image on a dedicated network. openssl is present for the O-series
# scenarios (openssl s_client probes).
FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY src/ .
RUN CGO_ENABLED=0 go build -trimpath -o /out/tmb ./cmd/tmb

FROM ubuntu:25.10@sha256:7cc5e35f6567ee8c66d2abb4aab0fd866669e6207c237c3a8f0947a5c7f17092
# upgrade: the digest-pinned base lags distro security fixes; Trivy gates the result
# hadolint ignore=DL3008 # disposable test image: distro package versions roll; the built image is scanned by Trivy on every PR
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends curl openssl \
 && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 4242 tmb \
 && useradd -u 4242 -g tmb -m -s /bin/bash tmb \
 && mkdir -p /run/tmb
COPY --from=build /out/tmb /usr/local/bin/tmb
# hadolint ignore=DL3066 # tmb is created above with uid/gid 4242
USER tmb
WORKDIR /home/tmb
CMD ["sleep", "infinity"]
